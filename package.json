{
  "name": "railcore",
  "productName": "RAILCORE",
  "version": "0.1.0",
  "description": "RAILCORE — simulador ferroviario. Prototipo: Renfe Civia en Cercanías Sevilla C-1 (Santa Justa – Utrera).",
  "main": "electron/main.js",
  "author": "RAILCORE",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/core.test.js",
    "dist:win": "electron-builder --win portable nsis --x64 --publish never",
    "dist:win-zip": "electron-builder --win zip --x64 --publish never"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "es.railcore.sim",
    "productName": "RAILCORE",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "styles.css",
      "src/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.png",
      "artifactName": "RAILCORE-${version}-${arch}-${target}.${ext}",
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "RAILCORE-${version}-portable.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "RAILCORE-${version}-instalador.exe",
      "shortcutName": "RAILCORE"
    }
  }
}
